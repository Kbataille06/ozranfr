      min-height: 0;
      flex: 1;
      padding: 8px 25px 0;
    }
    .ozran-mobile-nav__intro {
      font-size: 13px;
      font-weight: 600;
      letter-spacing: .28em;
      padding: 6px 0 22px;
      border-bottom: 1px solid #414141;
    }
    .ozran-mobile-nav__intro span { font-size: 10px; font-weight: 400; letter-spacing: .13em; color: #999; }
    .ozran-mobile-nav__scroll {
      flex: 1; min-height: 0; overflow-y: auto; overscroll-behavior: contain;
      -webkit-overflow-scrolling: touch; scrollbar-width: none; padding: 18px 0 35px;
    }
    .ozran-mobile-nav__scroll::-webkit-scrollbar { display: none; }
    .ozran-mobile-nav__item { display: block; border-bottom: 1px solid #303030; }
    .ozran-mobile-nav__heading {
      display: flex; justify-content: space-between; align-items: center;
      min-height: 72px; padding: 10px 2px;
      color: #f5f2ed; text-decoration: none;
      text-transform: uppercase; font-size: clamp(22px, 6.2vw, 31px);
      letter-spacing: .065em; font-weight: 500; cursor: pointer;
      list-style: none;
    }
    .ozran-mobile-nav__heading::-webkit-details-marker,
    .ozran-mobile-nav__nested summary::-webkit-details-marker { display: none; }
    .ozran-mobile-nav__plus { font-size: 25px; font-weight: 300; transition: transform .2s ease; }
    .ozran-mobile-nav__item[open] > .ozran-mobile-nav__heading .ozran-mobile-nav__plus { transform: rotate(45deg); }
    .ozran-mobile-nav__children { display: flex; flex-direction: column; padding: 0 0 16px 13px; }
    .ozran-mobile-nav__children > a, .ozran-mobile-nav__nested > summary,
    .ozran-mobile-nav__grandchildren > a {
      display: flex; align-items: center; justify-content: space-between;
      min-height: 47px; color: #c7c7c7; text-decoration: none;
      font-size: 14px; letter-spacing: .085em; text-transform: uppercase; line-height: 1.4;
    }
    .ozran-mobile-nav__nested > summary { cursor: pointer; list-style: none; }
    .ozran-mobile-nav__nested[open] > summary span:last-child { transform: rotate(45deg); }
    .ozran-mobile-nav__grandchildren { display: flex; flex-direction: column; padding-left: 17px; }
    .ozran-mobile-nav__grandchildren > a { color: #999; font-size: 12px; min-height: 40px; }
    .ozran-mobile-nav__signature {
      flex-shrink: 0; border-top: 1px solid #414141; padding: 17px 0 9px;
      text-align: center; color: #8e8e8e; font-size: 10px; letter-spacing: .19em;
    }
  }

  /* OZRAN mobile horizontal navigation layout */
  @media screen and (max-width: 749px) {
    .header-drawer .menu-drawer {padding: max(env(safe-area-inset-top), 4px) 0 max(env(safe-area-inset-bottom), 8px) !important;}
    .header-drawer .menu-drawer > .menu-drawer__close-button {
      position: absolute; left: 8px; right: auto; top: max(env(safe-area-inset-top), 4px);
      width: 53px; height: 62px; padding: 15px; z-index: 4;
    }
    .header-drawer .ozran-mobile-nav { padding: 0; min-height: 0; }
    .ozran-mobile-nav__top { flex: 0 0 67px; display:flex; justify-content:center; align-items:center; position:relative; padding:0 61px; }
    .ozran-mobile-nav__brand { display:flex; align-items:center; justify-content:center; color:#f5f2ed; text-decoration:none; letter-spacing:.18em; font-size:25px; font-weight:400; height:62px; max-width:100%; }
    .ozran-mobile-nav__brand img {display:block; max-width:145px; max-height:45px; width:auto; height:auto; object-fit:contain;}
    .ozran-mobile-nav__cart { position:absolute; right:15px; top:0; width:49px; height:62px; color:#f5f2ed; display:flex; justify-content:center; align-items:center; }
    .ozran-mobile-nav__tabs {flex:0 0 auto; display:flex; width:100%; overflow-x:auto; overscroll-behavior-x:contain; -webkit-overflow-scrolling:touch; scrollbar-width:none; gap:27px; padding:0 21px; border-bottom:1px solid #333;}
    .ozran-mobile-nav__tabs::-webkit-scrollbar{display:none;}
    .ozran-mobile-nav__tab {flex:0 0 auto; min-height:60px; padding:15px 1px 12px; border:0; border-bottom:2px solid transparent; border-radius:0; outline-offset:-3px; background:transparent; color:#a8a8a8; font:inherit; font-size:12px; font-weight:500; letter-spacing:.065em; text-transform:uppercase; white-space:nowrap; cursor:pointer;}
    .ozran-mobile-nav__tab.is-active {color:#fff; border-bottom-color:#fff;}
    .ozran-mobile-nav__content {flex:1; min-height:0; overflow-y:auto; overscroll-behavior:contain; -webkit-overflow-scrolling:touch; padding:27px 24px 48px;}
    .ozran-mobile-nav__panel[hidden]{display:none !important;}
    .ozran-mobile-nav__panel {display:block;}
    .ozran-mobile-nav__section-link, .ozran-mobile-nav__nested > summary {display:flex; width:100%; justify-content:space-between; align-items:center; min-height:65px; padding:12px 4px; font-size:17px; font-weight:400; letter-spacing:.025em; color:#f0f0f0; text-transform:none; text-decoration:none; border-bottom:1px solid #282828; cursor:pointer;}
    .ozran-mobile-nav__nested > summary {list-style:none;}
    .ozran-mobile-nav__nested > summary::-webkit-details-marker{display:none;}
    .ozran-mobile-nav__section-link span, .ozran-mobile-nav__arrow{font-size:22px; color:#dadada; font-weight:300;}
    .ozran-mobile-nav__nested[open] .ozran-mobile-nav__arrow{transform:rotate(45deg);}
    .ozran-mobile-nav__grandchildren{display:flex; flex-direction:column; padding:8px 0 15px 17px;}
    .ozran-mobile-nav__grandchildren > a{font-size:14px; color:#bcbcbc; text-decoration:none; padding:13px 3px;}
    .ozran-mobile-nav__see-all{display:inline-block; margin:28px 4px; color:#a1a1a1; font-size:11px; letter-spacing:.09em; text-decoration:none; text-transform:uppercase;}
  }

  @media screen and (max-width: 749px) {
    .header-drawer .menu-drawer > .menu-drawer__close-button,
    .header-drawer .menu-drawer > .menu-drawer__close-button:focus,
    .header-drawer .menu-drawer > .menu-drawer__close-button:active {
      border: 0 !important; outline: none !important; box-shadow: none !important;
      background: transparent !important; border-radius: 0 !important;
      -webkit-tap-highlight-color: transparent;
    }
    .header-drawer .menu-drawer > .menu-drawer__close-button:focus-visible {outline: 1px solid #aaa !important;outline-offset:-4px !important;}
    .header-drawer .menu-drawer > .menu-drawer__close-button::after,
    .header-drawer .menu-drawer > .menu-drawer__close-button::before {box-shadow:none !important;border:0 !important;}
    .ozran-mobile-nav__cart-icon {display:flex;width:27px;height:27px;align-items:center;justify-content:center;}
    .ozran-mobile-nav__cart-icon svg {width:27px !important;height:27px !important;display:block;}
    .ozran-mobile-nav__section-link, .ozran-mobile-nav__nested > summary {
      font-family: var(--font-heading--family, Georgia, serif) !important;
      font-weight: 400 !important;
      font-size: clamp(16px, 4.3vw, 18px) !important;
      letter-spacing: .065em !important;
      min-height: 64px !important;
      border-bottom: 1px solid rgba(255,255,255,.13) !important;
      padding-inline: 3px 6px !important;
    }
    .ozran-mobile-nav__grandchildren > a {font-family: var(--font-body--family, sans-serif);letter-spacing:.045em;font-size:14px;line-height:1.55;padding-block:15px;}
    .ozran-mobile-nav__section-link span, .ozran-mobile-nav__nested .ozran-mobile-nav__arrow {font-family:var(--font-body--family,sans-serif);font-size:21px;color:#999;}
    .ozran-mobile-nav__content {padding-top:31px !important;}
  }

  /* OZRAN mobile: match the banner's Oswald heading font */
  @media screen and (max-width: 749px) {
    .header-drawer .ozran-mobile-nav__section-link,
    .header-drawer .ozran-mobile-nav__nested > summary,
    .header-drawer .ozran-mobile-nav__grandchildren > a {
      font-family: var(--font-heading--family), "Oswald", sans-serif !important;
      font-weight: 100 !important;
      font-style: normal;
      letter-spacing: .035em !important;
    }
    .header-drawer .ozran-mobile-nav__section-link,
    .header-drawer .ozran-mobile-nav__nested > summary {
      font-size: 16px !important;
      line-height: 1.5 !important;
    }
    .header-drawer .ozran-mobile-nav__grandchildren > a {font-size:14px !important;}
  }

  @media screen and (max-width: 749px) {
    .ozran-mobile-nav__cart {right: 12px !important; width: 43px !important;}
    .ozran-mobile-nav__account {position:absolute;right:54px;top:0;width:40px;height:62px;display:flex;align-items:center;justify-content:center;color:#f5f2ed;text-decoration:none;}
    .ozran-mobile-nav__account svg {width:23px;height:23px;}
  }
  @media screen and (max-width: 749px) { .ozran-mobile-nav__tab--link {display:flex;align-items:center;text-decoration:none;min-height:60px;} }

  @media screen and (max-width: 749px) {
    .ozran-mobile-nav__cart {position:absolute;}
    .ozran-mobile-nav__cart {isolation:isolate;overflow:visible;}
    .ozran-cart-count {
      position:absolute;right:-1px;top:4px;display:flex;align-items:center;justify-content:center;
      min-width:16px;height:16px;padding:0 3px;border-radius:2px;
      background:#f5f2ed;color:#0e0e0e;font:500 10px/1 var(--font-body--family,sans-serif);
      letter-spacing:-.03em;pointer-events:none;z-index:2;
    }
    .ozran-cart-count.is-empty{display:none;}
    .ozran-cart-orbit{
      position:absolute;inset:8px 5px 8px 5px;border:1px solid rgba(245,242,237,.5);
      border-radius:50%;transform:scale(.68) rotate(-35deg);opacity:0;pointer-events:none;
    }
    .ozran-cart-toast{
      position:absolute;right:0;top:55px;padding:9px 12px;white-space:nowrap;display:flex;align-items:baseline;gap:7px;
      background:#f5f2ed;color:#0e0e0e;border:1px solid #bbb9b4;
      transform:translateY(-8px);opacity:0;visibility:hidden;pointer-events:none;
      transition:transform .32s ease,opacity .32s ease,visibility .32s;z-index:12;
      box-shadow:0 12px 22px rgba(0,0,0,.2);
    }
    .ozran-cart-toast strong{font:500 17px/1 var(--font-heading--family,sans-serif);letter-spacing:.02em;}
    .ozran-cart-toast span{font:400 9px/1 var(--font-body--family,sans-serif);letter-spacing:.17em;}
    .ozran-cart-toast.is-visible{transform:translateY(0);opacity:1;visibility:visible;}
    .ozran-cart-activated .ozran-cart-orbit{animation:ozran-orbit-reveal 1s cubic-bezier(.2,.7,.2,1);}
    .ozran-cart-count--pop{animation:ozran-count-flip .55s cubic-bezier(.2,.8,.2,1);}
    @keyframes ozran-orbit-reveal{
      0%{opacity:0;transform:scale(.65) rotate(-35deg);}
      24%{opacity:.8;transform:scale(1) rotate(45deg);}
      75%{opacity:.5;transform:scale(1.18) rotate(245deg);}
      100%{opacity:0;transform:scale(1.32) rotate(330deg);}
    }
    @keyframes ozran-count-flip{
      0%{transform:translateY(-5px);opacity:0;}
      65%{transform:translateY(1px);opacity:1;}
      100%{transform:translateY(0);}
    }
    @media (prefers-reduced-motion:reduce){
      .ozran-cart-activated .ozran-cart-orbit,.ozran-cart-count--pop{animation:none;}
      .ozran-cart-toast{transition:none;}
    }
  }

  /* OZRAN mobile cinematic fade — drawer stays fixed and fullscreen */
  @media screen and (max-width: 749px) {
    .header-drawer .menu-drawer {
      transform: none !important;
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity .42s cubic-bezier(.22,1,.36,1), visibility .42s !important;
    }
    .header-drawer .menu-drawer-container.menu-open > .menu-drawer {
      opacity: 1;
      visibility: visible;
      pointer-events: auto;
    }
    .header-drawer .ozran-mobile-nav__top,
    .header-drawer .ozran-mobile-nav__tabs,
    .header-drawer .ozran-mobile-nav__content {
      opacity: 0;
      transform: translateY(11px);
      transition: opacity .48s cubic-bezier(.22,1,.36,1), transform .58s cubic-bezier(.22,1,.36,1);
    }
    .header-drawer .menu-open .ozran-mobile-nav__top {
      opacity:1;transform:translateY(0);transition-delay:.07s;
    }
    .header-drawer .menu-open .ozran-mobile-nav__tabs {
      opacity:1;transform:translateY(0);transition-delay:.13s;
    }
    .header-drawer .menu-open .ozran-mobile-nav__content {
      opacity:1;transform:translateY(0);transition-delay:.2s;
    }
  }
  @media screen and (max-width: 749px) and (prefers-reduced-motion: reduce) {
    .header-drawer .menu-drawer,
    .header-drawer .ozran-mobile-nav__top,
    .header-drawer .ozran-mobile-nav__tabs,
    .header-drawer .ozran-mobile-nav__content {
      transition:none !important;transform:none !important;
    }
  }

@media(max-width:749px){
 .ozran-nexus-mobile .ozran-mobile-nav__grandchildren{opacity:0;transform:translateY(-7px);transition:opacity .32s ease,transform .38s cubic-bezier(.2,.7,.2,1);}
 .ozran-nexus-mobile[open] .ozran-mobile-nav__grandchildren{opacity:1;transform:translateY(0);}
