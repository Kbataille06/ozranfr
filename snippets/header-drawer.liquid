      <script>
        (function(){
          function initOzranTabs(root){
            if(!root || root.dataset.ozranTabsReady)return;
            root.dataset.ozranTabsReady='true';
            // Only the "Les articles" summaries use two-stage navigation.
            // Closed: allow native <details> to open. Open: follow its collection.
            root.querySelectorAll('.ozran-mobile-nav__nested--articles').forEach(function(details){
              var summary=details.querySelector('summary');
              var href=details.getAttribute('data-collection-href');
              if(!summary || !href)return;
              summary.addEventListener('click',function(event){
                if(!details.open)return;
                event.preventDefault();
                window.location.href=href;
              });
            });
            var tabs=Array.from(root.querySelectorAll('.ozran-mobile-nav__tab'));
            tabs.forEach(function(tab){
              tab.addEventListener('click',function(){
                tabs.forEach(function(t){
                  var active=t===tab;
                  t.classList.toggle('is-active',active);
                  t.setAttribute('aria-selected',String(active));
                  t.tabIndex=active?0:-1;
                  var panel=root.querySelector('#'+t.getAttribute('aria-controls'));
                  if(panel)panel.hidden=!active;
                });
                tab.scrollIntoView({behavior:'smooth',block:'nearest',inline:'center'});
              });
            });
          }
          var nav=document.currentScript.previousElementSibling;
          if(nav && nav.classList.contains('ozran-mobile-nav'))initOzranTabs(nav);
        })();
      </script>

      <script>
        (function () {
          var root = document.currentScript.previousElementSibling;
          if (!root || !root.classList.contains('ozran-mobile-nav') || root.dataset.ozranCartReady) return;
          root.dataset.ozranCartReady = 'true';
          var badge = root.querySelector('[data-ozran-cart-count]');
          var description = root.querySelector('[data-ozran-cart-description]');
          var link = root.querySelector('.ozran-mobile-nav__cart');
          var previous = Number(badge.textContent.trim()) || 0;
          var toast = root.querySelector('[data-ozran-cart-toast]');
          var toastNumber = root.querySelector('[data-ozran-cart-toast-number]');
          var toastLabel = root.querySelector('[data-ozran-cart-toast-label]');
          var toastTimer;
          var requestNumber = 0;
          function setCount(count) {
            count = Math.max(0, Number(count) || 0);
            badge.textContent = count > 99 ? '99+' : String(count);
            badge.classList.toggle('is-empty', count === 0);
            description.textContent = count + (count === 1 ? ' article dans le panier' : ' articles dans le panier');
            link.setAttribute('aria-label', 'Panier, ' + description.textContent);
            if (count !== previous) {
              badge.classList.remove('ozran-cart-count--pop');
              void badge.offsetWidth;
              badge.classList.add('ozran-cart-count--pop');
              link.classList.remove('ozran-cart-activated');
              void link.offsetWidth;
              link.classList.add('ozran-cart-activated');
              toastNumber.textContent=String(count).padStart(2,'0');
              toastLabel.textContent=count===1?'PIÈCE':'PIÈCES';
              toast.classList.add('is-visible');
              clearTimeout(toastTimer);
              toastTimer=setTimeout(function(){toast.classList.remove('is-visible');link.classList.remove('ozran-cart-activated')},2000);
              previous = count;
            }
          }
          function refresh() {
            var n = ++requestNumber;
            fetch((window.Shopify && window.Shopify.routes ? window.Shopify.routes.root : '/') + 'cart.js', {credentials:'same-origin'})
              .then(function(response){if(!response.ok)throw new Error('Panier inaccessible');return response.json()})
              .then(function(cart){if(n===requestNumber)setCount(cart.item_count)})
              .catch(function(){});
          }
          link.setAttribute('aria-label','Panier, ' + description.textContent);
          document.addEventListener('cart:refresh',refresh);
          document.addEventListener('cart:update',refresh);
          document.addEventListener('cart:change',refresh);
          document.addEventListener('cart:updated',refresh);
          root.closest('header-drawer')?.addEventListener('click',function(event){
            if(event.target.closest('.header__icon--menu'))refresh();
          });
        })();
      </script>
