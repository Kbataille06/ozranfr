{% doc %}
  Renders a native swipe gallery for a homepage product.
  @param {product} product - Product shown in the card.
{% enddoc %}
<div class="ozran-home-gallery" tabindex="0" aria-label="{{ product.title | escape }}">
  {% for image in product.images limit: 8 %}
    <div class="ozran-home-gallery__slide">
      {{ image | image_url: width: 900 | image_tag: loading: 'lazy', widths: '300,450,650,900', sizes: '(max-width: 749px) 50vw, 33vw', draggable: 'false' }}
    </div>
  {% endfor %}
</div>
