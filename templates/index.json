les %}\n{% assign product = all_products[ozran_handle] %}\n{% if product != blank %}<a class=\"ozran-duo__item\" href=\"{{ product.url }}\" aria-label=\"{{ product.title | escape }}\"><div class=\"ozran-duo__media\">{% if product.featured_image != blank %}{% render 'ozran-home-gallery', product: product %}{% endif %}</div><div class=\"ozran-duo__title\">{{ product.title | escape }}</div><div class=\"ozran-duo__price\">{{ product.price | money }}</div></a>{% endif %}\n{% endfor %}\n</div><a class=\"ozran-duo__more\" href=\"{{ routes.all_products_collection_url }}\">DÉCOUVRIR TOUTES LES PIÈCES</a>\n</section>",
